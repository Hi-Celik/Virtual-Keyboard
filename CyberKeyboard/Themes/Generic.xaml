<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CyberKeyboard.Controls">

    <Style TargetType="{x:Type controls:CyberKeyControl}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Margin" Value="2.5,2,2.5,3.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CyberKeyControl}">
                    <Border x:Name="PART_OuterBorder"
                            CornerRadius="8"
                            BorderThickness="1.5"
                            Background="#D00D1525"
                            BorderBrush="#6000F0FF"
                            Padding="2">
                        <Grid>
                            <!-- Top Left Shift / Sub text -->
                            <TextBlock x:Name="PART_ShiftText"
                                       Text="{Binding KeyModel.CornerShiftText, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#9CD5FF"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="6,3,0,0"/>

                            <!-- Top Right LED status indicator for Caps / Shift -->
                            <Ellipse x:Name="PART_LedIndicator"
                                     Width="6"
                                     Height="6"
                                     Fill="#00F0FF"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,5,6,0"
                                     Visibility="Collapsed"/>

                            <!-- Center Main Symbol wrapped in Viewbox: Big, bold, prominent letters -->
                            <Viewbox Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     MaxHeight="58"
                                     Margin="6,3"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <TextBlock x:Name="PART_MainText"
                                           Text="{Binding KeyModel.CurrentDisplay, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           FontFamily="Segoe UI, Consolas, sans-serif"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Viewbox>

                            <!-- Bottom Right AltGr Symbol -->
                            <TextBlock x:Name="PART_AltGrText"
                                       Text="{Binding KeyModel.CornerAltGrText, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#FFAA00"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,6,3"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
